      <HintPath>E:\Games\Shadows of Doubt\Game\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Falls das Spiel Il2Cpp verwendet, brauchst du evtl. auch diese Referenz -->
